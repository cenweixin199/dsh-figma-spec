{
  "name": "dsh-figma-spec",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Read a Figma frame's real style data (box, fills, per-side strokes, gradients, effects, radii, arc data, grid gaps, typography) over the REST API and render it as a spec table, type scale, palette, or node diff.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./docs/*": "./docs/*"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "SKILL.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "figma",
    "design-spec",
    "design-tokens",
    "rest-api"
  ],
  "engines": {
    "node": ">=20"
  }
}